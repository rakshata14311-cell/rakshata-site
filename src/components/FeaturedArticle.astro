---
interface Props {
  entry: any;
  size?: 'large' | 'regular';
}

const { entry, size = 'regular' } = Astro.props;
const { title, description, category, platform, readingTime, coverImage, date } = entry.data;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
});
---

<a href={`/writing/${entry.slug}`} class={`featured-card ${size}`}>
  {coverImage && (
    <div class="image-wrap">
      <img src={coverImage} alt="" loading="lazy" />
    </div>
  )}
  <div class="text-wrap">
    <p class="eyebrow">{category}</p>
    <h3 class="title">{title}</h3>
    {size === 'large' && <p class="excerpt">{description}</p>}
    <p class="meta">{readingTime} &middot; {platform} &middot; {formattedDate}</p>
  </div>
</a>

<style>
  .featured-card {
    display: block;
  }

  .featured-card.large {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 64px;
  }

  .featured-card.large .image-wrap img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 3px;
  }

  .featured-card.large .title {
    font-size: 34px;
    line-height: 1.2;
    margin: 10px 0 16px;
  }

  .featured-card.large .excerpt {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 16px;
    max-width: 44ch;
  }

  .featured-card.regular .image-wrap img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 3px;
    margin-bottom: 16px;
  }

  .featured-card.regular .title {
    font-size: 20px;
    line-height: 1.3;
    margin: 8px 0 10px;
  }

  .featured-card:hover .title {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .featured-card.large {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 40px;
    }
    .featured-card.large .title {
      font-size: 26px;
    }
  }
</style>
