---
interface Props {
  entry: any;
  size?: 'large' | 'regular';
}

const { entry, size = 'regular' } = Astro.props;
const { title, description, category, platform, readingTime, date } = entry.data;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
});
---

<a href={`/writing/${entry.slug}`} class={`featured-card ${size}`}>
  <div class="text-wrap">
    <p class="eyebrow">{category}</p>
    <h3 class="title">{title}</h3>
    {size === 'large' && <p class="excerpt">{description}</p>}
    <p class="meta">{readingTime} &middot; {platform} &middot; {formattedDate}</p>
  </div>
</a>

<style>
  .featured-card {
    display: block;
  }

  .featured-card.large {
    padding: 40px;
    background: var(--accent-tint);
    border-radius: 4px;
    margin-bottom: 40px;
    transition: transform 0.2s ease;
  }

  .featured-card.large .title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(30px, 4.5vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 14px 0 20px;
    max-width: 18ch;
  }

  .featured-card.large .excerpt {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 20px;
    max-width: 48ch;
  }

  .featured-card.regular {
    padding-top: 24px;
    border-top: 2px solid var(--ink);
  }

  .featured-card.regular .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.25;
    margin: 10px 0 12px;
    transition: color 0.2s ease;
  }

  .featured-card:hover .title {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .featured-card.large {
      padding: 28px;
    }
  }
</style>
