---
interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { title, description, category, platform, readingTime, coverImage, date } = entry.data;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
});
---

<a href={`/writing/${entry.slug}`} class="article-card">
  <div class="card-top">
    <p class="eyebrow">{category}</p>
    <h4 class="title">{title}</h4>
    <p class="excerpt">{description}</p>
  </div>
  <p class="meta">{readingTime} &middot; {platform} &middot; {formattedDate}</p>
</a>

<style>
  .article-card {
    display: block;
    padding: 28px 0;
    border-top: 1px solid var(--hairline);
  }

  .title {
    font-size: 21px;
    line-height: 1.3;
    margin: 8px 0 8px;
  }

  .excerpt {
    font-family: var(--font-serif);
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 12px;
    max-width: 56ch;
  }

  .article-card:hover .title {
    color: var(--accent);
  }
</style>
