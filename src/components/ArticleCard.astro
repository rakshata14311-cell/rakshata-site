---
interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { title, description, category, platform, readingTime, coverImage, date } = entry.data;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
});
---

<a href={`/writing/${entry.slug}`} class={`article-card ${coverImage ? 'has-image' : 'no-image'}`}>
  <div class="card-text">
    <p class="eyebrow">{category}</p>
    <h4 class="title">{title}</h4>
    <p class="excerpt">{description}</p>
    <p class="meta">{readingTime} &middot; {platform} &middot; {formattedDate}</p>
  </div>
  {coverImage && (
    <div class="card-thumb">
      <img src={coverImage} alt="" loading="lazy" />
    </div>
  )}
</a>

<style>
  .article-card {
    display: grid;
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--hairline);
    align-items: center;
  }

  .article-card.has-image {
    grid-template-columns: 1fr 180px;
  }

  .article-card.no-image {
    grid-template-columns: 1fr;
  }

  .title {
    font-size: 21px;
    line-height: 1.3;
    margin: 8px 0 8px;
  }

  .excerpt {
    font-family: var(--font-serif);
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 12px;
    max-width: 56ch;
  }

  .card-thumb img {
    width: 180px;
    height: 120px;
    object-fit: cover;
    border-radius: 3px;
    background: var(--hairline);
  }

  .article-card:hover .title {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .article-card.has-image {
      grid-template-columns: 1fr;
    }
    .card-thumb {
      order: -1;
    }
    .card-thumb img {
      width: 100%;
      height: 180px;
    }
  }
</style>
