---
interface Props {
  entry: any;
  index?: number;
}

const { entry, index } = Astro.props;
const { title, description, category, platform, readingTime, date } = entry.data;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
});

const num = index !== undefined ? String(index + 1).padStart(2, '0') : null;
---

<a href={`/writing/${entry.slug}`} class="article-card">
  {num && <span class="index" aria-hidden="true">{num}</span>}
  <div class="card-body">
    <p class="eyebrow">{category}</p>
    <h4 class="title">{title}</h4>
    <p class="excerpt">{description}</p>
    <p class="meta">{readingTime} &middot; {platform} &middot; {formattedDate}</p>
  </div>
</a>

<style>
  .article-card {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 28px;
    padding: 32px 0;
    border-top: 1px solid var(--hairline);
    align-items: baseline;
    transition: background 0.2s ease;
  }

  .index {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 4px;
  }

  .article-card:hover .index {
    color: var(--accent);
  }

  .title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 23px;
    line-height: 1.25;
    margin: 8px 0 10px;
    transition: color 0.2s ease;
  }

  .excerpt {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 14px;
    max-width: 60ch;
  }

  .article-card:hover .title {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .article-card {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 26px 0;
    }
    .index {
      display: none;
    }
    .title {
      font-size: 21px;
    }
  }
</style>
