---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allWriting = await getCollection('writing');
const sorted = allWriting.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing" description="Essays, stories, culture writing, and book reviews by Rakshita Mulimani.">
  <section class="wrap header-section">
    <h1>Writing</h1>
    <p class="intro">Every piece, in one place. Filtering by category, platform, and year — plus search — is coming in the next pass; for now, here's everything in order.</p>
  </section>

  <section class="wrap reading-column">
    {sorted.map((entry) => (
      <ArticleCard entry={entry} />
    ))}
  </section>
</BaseLayout>

<style>
  .header-section {
    padding: 56px 0 32px;
  }

  h1 {
    font-size: 40px;
  }

  .intro {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--muted);
    margin-top: 16px;
    max-width: 480px;
    line-height: 1.6;
  }
</style>
