---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Rakshata.">
  <section class="wrap reading-column contact-page">
    <h1>Contact</h1>
    <p class="intro-text">Want to talk about writing, storytelling, content, or some interesting idea that won't leave you alone? I'd like to hear it.</p>
    <div class="contact-links">
      <a href="mailto:rakshata14311@gmail.com">rakshata14311@gmail.com</a>
      <a href="https://www.linkedin.com/in/rakshata-mulimani-b79439215/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding: 56px 0 96px;
  }

  h1 {
    font-size: 40px;
    margin-bottom: 24px;
  }

  .intro-text {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.5;
    margin-bottom: 32px;
    max-width: 30ch;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-links a {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
    width: fit-content;
    border-bottom: 1px solid transparent;
  }

  .contact-links a:hover {
    border-bottom-color: var(--accent);
  }
</style>
