---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Rakshita Mulimani.">
  <section class="wrap reading-column placeholder-section">
    <h1>Contact</h1>
    <p class="placeholder-note">Placeholder — needs your real email address and LinkedIn URL before this goes live. Currently just a shell.</p>
    <hr class="hairline" />
    <p class="intro-text">Have an idea, project, or interesting question?</p>
    <div class="contact-links">
      <a href="mailto:hello@example.com">Email</a>
      <a href="#">LinkedIn</a>
    </div>
  </section>
</BaseLayout>

<style>
  .placeholder-section {
    padding: 56px 0 96px;
  }

  h1 {
    font-size: 40px;
    margin-bottom: 24px;
  }

  .placeholder-note {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--accent);
    background: var(--accent-tint);
    padding: 16px 20px;
    border-radius: 3px;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .intro-text {
    font-family: var(--font-serif);
    font-size: 22px;
    margin: 24px 0 20px;
  }

  .contact-links {
    display: flex;
    gap: 24px;
  }

  .contact-links a {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
  }
</style>
